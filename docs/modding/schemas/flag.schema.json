{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/flag.schema.json",
  "title": "Mod flags",
  "oneOf": [
    { "$ref": "#/$defs/flagList" },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": { "$ref": "#/$defs/flagList" }
      },
      "required": ["flags"]
    }
  ],
  "$defs": {
    "flagList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/flag" }
        ]
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "initial": { "type": "boolean", "default": false }
      }
    }
  }
}
