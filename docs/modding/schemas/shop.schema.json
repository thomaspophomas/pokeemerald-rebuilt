{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/shop.schema.json",
  "title": "Mod shops",
  "oneOf": [
    { "$ref": "#/$defs/shopList" },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shops": { "$ref": "#/$defs/shopList" }
      },
      "required": ["shops"]
    }
  ],
  "$defs": {
    "shopList": {
      "type": "array",
      "items": { "$ref": "#/$defs/shop" }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "map": { "$ref": "#/$defs/token" },
        "mapGroup": { "$ref": "#/$defs/token" },
        "map_group": { "$ref": "#/$defs/token" },
        "mapNum": { "$ref": "#/$defs/token" },
        "map_num": { "$ref": "#/$defs/token" },
        "type": { "$ref": "#/$defs/token" },
        "martType": { "$ref": "#/$defs/token" },
        "mart_type": { "$ref": "#/$defs/token" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/token" }
        },
        "priority": { "$ref": "#/$defs/s16", "default": 1000 },
        "flags": {},
        "mode": { "$ref": "#/$defs/hookMode" }
      },
      "required": ["items"]
    },
    "token": {
      "oneOf": [{ "type": "integer" }, { "type": "string", "minLength": 1 }]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "hookMode": {
      "type": "string",
      "enum": ["observe", "modify", "replace", "claim"],
      "default": "observe"
    }
  }
}
