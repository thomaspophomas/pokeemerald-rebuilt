{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/mod.schema.json",
  "title": "pokeemerald-rebuilt mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "requiresSdk": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^(>=|<=|==|=|>|<)?\\s*[0-9]+$"
        }
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "default": 1000
    },
    "featureFlags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "default": 0
    },
    "features": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "default": 0,
      "deprecated": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/modId" },
      "uniqueItems": true,
      "default": []
    },
    "loadAfter": {
      "type": "array",
      "items": { "$ref": "#/$defs/modId" },
      "uniqueItems": true,
      "default": []
    },
    "conflictsWith": {
      "type": "array",
      "items": { "$ref": "#/$defs/modId" },
      "uniqueItems": true,
      "default": []
    },
    "requiresFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "uniqueItems": true,
      "default": []
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "default": 0
    },
    "stateBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 224,
      "default": 0
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./-]+\\.c$"
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "$defs": {
    "modId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    }
  }
}
