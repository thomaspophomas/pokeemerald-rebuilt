{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/sprite_asset.schema.json",
  "title": "Mod sprite_asset",
  "oneOf": [
    {
      "$ref": "#/$defs/itemList"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_meta": {
          "type": "object"
        },
        "assets": {
          "$ref": "#/$defs/itemList"
        }
      },
      "required": [
        "assets"
      ]
    }
  ],
  "$defs": {
    "itemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "modify",
            "replace",
            "claim"
          ],
          "default": "observe"
        },
        "sheet": {
          "$ref": "#/$defs/cIdentifier"
        },
        "sheetSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressedSheet": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressedSheetSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressed_sheet": {
          "$ref": "#/$defs/cIdentifier"
        },
        "palette": {
          "$ref": "#/$defs/cIdentifier"
        },
        "paletteSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressedPalette": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressedPaletteSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "compressed_palette": {
          "$ref": "#/$defs/cIdentifier"
        },
        "template": {
          "$ref": "#/$defs/cIdentifier"
        },
        "templateSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "tileTag": {
          "$ref": "#/$defs/token"
        },
        "tile_tag": {
          "$ref": "#/$defs/token"
        },
        "paletteTag": {
          "$ref": "#/$defs/token"
        },
        "palette_tag": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "token": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "cIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    }
  }
}
