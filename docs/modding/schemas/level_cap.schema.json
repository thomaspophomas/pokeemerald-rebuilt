{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/level_cap.schema.json",
  "title": "Mod level cap",
  "oneOf": [
    {
      "$ref": "#/$defs/itemList"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_meta": {},
        "caps": {
          "$ref": "#/$defs/itemList"
        }
      },
      "required": [
        "caps"
      ]
    }
  ],
  "$defs": {
    "itemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/token"
        },
        "capType": {
          "$ref": "#/$defs/token"
        },
        "cap_type": {
          "$ref": "#/$defs/token"
        },
        "capsByBadge": {
          "$ref": "#/$defs/capTable"
        },
        "caps_by_badge": {
          "$ref": "#/$defs/capTable"
        },
        "stages": {
          "$ref": "#/$defs/stageList"
        },
        "capStages": {
          "$ref": "#/$defs/stageList"
        },
        "cap_stages": {
          "$ref": "#/$defs/stageList"
        },
        "softExpCurve": {
          "$ref": "#/$defs/softExpCurve"
        },
        "soft_exp_curve": {
          "$ref": "#/$defs/softExpCurve"
        },
        "expCurve": {
          "$ref": "#/$defs/softExpCurve"
        },
        "exp_curve": {
          "$ref": "#/$defs/softExpCurve"
        },
        "rareCandy": {
          "$ref": "#/$defs/token"
        },
        "rare_candy": {
          "$ref": "#/$defs/token"
        },
        "priority": {
          "$ref": "#/$defs/s16"
        },
        "flags": {}
      }
    },
    "capTable": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "stageList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "$ref": "#/$defs/level"
            },
            "cap": {
              "$ref": "#/$defs/level"
            },
            "maxLevel": {
              "$ref": "#/$defs/level"
            },
            "max_level": {
              "$ref": "#/$defs/level"
            },
            "flag": {
              "$ref": "#/$defs/nullableToken"
            },
            "vanillaFlag": {
              "$ref": "#/$defs/nullableToken"
            },
            "vanilla_flag": {
              "$ref": "#/$defs/nullableToken"
            },
            "modFlag": {
              "$ref": "#/$defs/token"
            },
            "mod_flag": {
              "$ref": "#/$defs/token"
            },
            "flagId": {
              "$ref": "#/$defs/token"
            },
            "flag_id": {
              "$ref": "#/$defs/token"
            }
          }
        }
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "delta": {
      "type": "integer",
      "minimum": -99,
      "maximum": 99
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "softExpCurve": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/percent"
          }
        },
        {
          "type": "array",
          "minItems": 199,
          "maxItems": 199,
          "items": {
            "$ref": "#/$defs/percent"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/softExpCurveEntry"
          }
        }
      ]
    },
    "softExpCurveEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delta": {
          "$ref": "#/$defs/delta"
        },
        "levelDelta": {
          "$ref": "#/$defs/delta"
        },
        "level_delta": {
          "$ref": "#/$defs/delta"
        },
        "minDelta": {
          "$ref": "#/$defs/delta"
        },
        "min_delta": {
          "$ref": "#/$defs/delta"
        },
        "maxDelta": {
          "$ref": "#/$defs/delta"
        },
        "max_delta": {
          "$ref": "#/$defs/delta"
        },
        "from": {
          "$ref": "#/$defs/delta"
        },
        "to": {
          "$ref": "#/$defs/delta"
        },
        "percent": {
          "$ref": "#/$defs/percent"
        }
      },
      "required": [
        "percent"
      ]
    },
    "token": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "nullableToken": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/token"
        }
      ]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    }
  }
}
