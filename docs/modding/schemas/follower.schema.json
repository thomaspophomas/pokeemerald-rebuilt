{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/follower.schema.json",
  "title": "Mod follower",
  "oneOf": [
    {
      "$ref": "#/$defs/itemList"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_meta": {
          "type": "object"
        },
        "followers": {
          "$ref": "#/$defs/itemList"
        }
      },
      "required": [
        "followers"
      ]
    }
  ],
  "$defs": {
    "itemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "modify",
            "replace",
            "claim"
          ],
          "default": "observe"
        },
        "species": {
          "$ref": "#/$defs/token"
        },
        "form": {
          "$ref": "#/$defs/u16"
        },
        "shiny": {
          "type": "boolean"
        },
        "graphicsId": {
          "$ref": "#/$defs/token"
        },
        "graphics_id": {
          "$ref": "#/$defs/token"
        },
        "asset": {
          "type": "string"
        },
        "assetKey": {
          "type": "string"
        },
        "asset_key": {
          "type": "string"
        },
        "graphicsRevision": {
          "$ref": "#/$defs/u16"
        },
        "graphics_revision": {
          "$ref": "#/$defs/u16"
        },
        "graphicsInfoSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "graphics_info_symbol": {
          "$ref": "#/$defs/cIdentifier"
        }
      }
    },
    "token": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "cIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    }
  }
}
