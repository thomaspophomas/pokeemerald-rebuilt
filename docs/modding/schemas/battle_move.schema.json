{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/battle_move.schema.json",
  "title": "Mod battle_move",
  "oneOf": [
    {
      "$ref": "#/$defs/itemList"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moves": {
          "$ref": "#/$defs/itemList"
        }
      },
      "required": [
        "moves"
      ]
    }
  ],
  "$defs": {
    "itemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "modify",
            "replace",
            "claim"
          ],
          "default": "observe"
        },
        "move": {
          "$ref": "#/$defs/token"
        },
        "moveId": {
          "$ref": "#/$defs/token"
        },
        "move_id": {
          "$ref": "#/$defs/token"
        },
        "priority": {
          "$ref": "#/$defs/s16"
        },
        "flags": {},
        "effect": {
          "$ref": "#/$defs/token"
        },
        "power": {
          "$ref": "#/$defs/token"
        },
        "type": {
          "$ref": "#/$defs/token"
        },
        "accuracy": {
          "$ref": "#/$defs/token"
        },
        "pp": {
          "$ref": "#/$defs/token"
        },
        "secondary": {
          "$ref": "#/$defs/token"
        },
        "target": {
          "$ref": "#/$defs/token"
        },
        "movePriority": {
          "$ref": "#/$defs/token"
        },
        "move_priority": {
          "$ref": "#/$defs/token"
        },
        "moveFlags": {
          "$ref": "#/$defs/token"
        },
        "move_flags": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "token": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "cIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    }
  }
}
