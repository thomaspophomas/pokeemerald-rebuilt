{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald-rebuilt.local/schemas/encounter.schema.json",
  "title": "Mod encounter",
  "oneOf": [
    {
      "$ref": "#/$defs/itemList"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encounters": {
          "$ref": "#/$defs/itemList"
        }
      },
      "required": [
        "encounters"
      ]
    }
  ],
  "$defs": {
    "itemList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "modify",
            "replace",
            "claim"
          ],
          "default": "observe"
        },
        "map": {
          "$ref": "#/$defs/token"
        },
        "mapGroup": {
          "$ref": "#/$defs/token"
        },
        "map_group": {
          "$ref": "#/$defs/token"
        },
        "mapNum": {
          "$ref": "#/$defs/token"
        },
        "map_num": {
          "$ref": "#/$defs/token"
        },
        "area": {
          "$ref": "#/$defs/token"
        },
        "encounterRate": {
          "$ref": "#/$defs/u16"
        },
        "encounter_rate": {
          "$ref": "#/$defs/u16"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "priority": {
          "$ref": "#/$defs/s16"
        },
        "flags": {},
        "hook": {
          "$ref": "#/$defs/cIdentifier"
        },
        "hookSymbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "hook_symbol": {
          "$ref": "#/$defs/cIdentifier"
        },
        "hookKey": {
          "$ref": "#/$defs/shortString"
        },
        "hook_key": {
          "$ref": "#/$defs/shortString"
        },
        "rodMask": {
          "$ref": "#/$defs/token"
        },
        "rod_mask": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "token": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "s16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "cIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    }
  }
}
