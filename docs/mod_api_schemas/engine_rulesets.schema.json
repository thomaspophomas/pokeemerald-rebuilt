{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokeemerald.local/mod_api_schemas/engine_rulesets.schema.json",
  "title": "Vanilla Engine Rulesets API",
  "description": "Modder-facing entity JSON representation for the vanilla engine_rulesets mod API domain. Each domain has an index.json, one or more entity JSON files, and _source_manifest.json only for audit and drift checks.",
  "type": "object",
  "required": [
    "domain",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "entityKind": {
      "type": "string"
    },
    "semanticCoverage": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "legacy": {
      "type": "object"
    },
    "entries": {
      "type": "array"
    }
  },
  "examples": [
    {
      "domain": "engine_rulesets",
      "schemaVersion": 1,
      "entityKind": "engine_rulesets_entity",
      "semanticCoverage": "full",
      "entries": [
        {
          "id": "EXAMPLE",
          "path": "EXAMPLE.json"
        }
      ]
    }
  ],
  "additionalProperties": true
}
